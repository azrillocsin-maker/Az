            <ol class="space-y-3 text-sm text-slate-600 dark:text-slate-300 list-decimal list-inside">
                <li><strong>Customize your info:</strong> Open <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono text-xs">index.html</code> and replace the bracketed placeholders like <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono text-xs">[Your Full Name]</code> with your real info.</li>
                <li><strong>Create a GitHub Repository:</strong> Go to GitHub.com, click <strong>New Repository</strong>, and name it <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono text-xs">yourusername.github.io</code> (or any name like <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono text-xs">my-portfolio</code>).</li>
                <li><strong>Upload <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono text-xs">index.html</code>:</strong> Click <strong>Add file &rarr; Upload files</strong>, drag this <code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 font-mono text-xs">index.html</code> file in, and click <strong>Commit changes</strong>.</li>
                <li><strong>Turn on GitHub Pages:</strong> Go to your repo's <strong>Settings &rarr; Pages</strong>, set Source to <strong>Deploy from a branch (main)</strong>, and click <strong>Save</strong>. Your live site link will appear in ~1 minute!</li>
            </ol>

            <div class="pt-2 flex justify-end">
                <button onclick="closeGithubModal()" class="px-5 py-2.5 rounded-xl text-sm font-semibold bg-primary-600 hover:bg-primary-700 text-white transition">
                    Got It!
                </button>
            </div>
        </div>
    </div>

    <!-- =====================================================================
         JAVASCRIPT: Routing, Theme Toggle, Age Calculator & Interactions
         ===================================================================== -->
    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // Set current year in footer
        document.getElementById('footer-year').textContent = new Date().getFullYear();

        // -----------------------------------------------------------------
        // 1. MULTI-PAGE HASH ROUTING
        // Allows bookmarking/sharing URLs like index.html#school or index.html#sports
        // -----------------------------------------------------------------
        const validPages = ['about', 'school', 'sports', 'age', 'hobbies', 'contact'];

        function navigateTo(pageId) {
            if (!validPages.includes(pageId)) pageId = 'about';

            // Hide all page sections
            document.querySelectorAll('.page-section').forEach(section => {
                section.classList.add('hidden');
            });

            // Show target page section
            const targetSection = document.getElementById(`page-${pageId}`);
            if (targetSection) {
                targetSection.classList.remove('hidden');
            }

            // Update active state on desktop nav links
            document.querySelectorAll('.nav-link').forEach(link => {
                if (link.dataset.page === pageId) {
                    link.classList.add('bg-primary-50', 'text-primary-700', 'dark:bg-primary-500/15', 'dark:text-primary-300', 'font-semibold');
                    link.classList.remove('text-slate-600', 'dark:text-slate-300', 'hover:bg-slate-100', 'dark:hover:bg-slate-800');
                } else {
                    link.classList.remove('bg-primary-50', 'text-primary-700', 'dark:bg-primary-500/15', 'dark:text-primary-300', 'font-semibold');
                    link.classList.add('text-slate-600', 'dark:text-slate-300', 'hover:bg-slate-100', 'dark:hover:bg-slate-800');
                }
            });

            // Update active state on mobile nav links
            document.querySelectorAll('.mobile-nav-link').forEach(link => {
                if (link.dataset.page === pageId) {
                    link.classList.add('bg-primary-50', 'text-primary-700', 'dark:bg-primary-500/15', 'dark:text-primary-300', 'font-semibold');
                    link.classList.remove('text-slate-700', 'dark:text-slate-200');
                } else {
                    link.classList.remove('bg-primary-50', 'text-primary-700', 'dark:bg-primary-500/15', 'dark:text-primary-300', 'font-semibold');
                    link.classList.add('text-slate-700', 'dark:text-slate-200');
                }
            });

            // Close mobile menu if open & scroll smoothly to top
            toggleMobileMenu(false);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Listen for browser back/forward hash changes
        window.addEventListener('hashchange', () => {
            const hash = window.location.hash.replace('#', '');
            navigateTo(hash || 'about');
        });

        // Initial page load check
        window.addEventListener('DOMContentLoaded', () => {
            const initialHash = window.location.hash.replace('#', '');
            navigateTo(initialHash || 'about');
            updateAgeStats(document.getElementById('birthdate-input').value);
        });

        // -----------------------------------------------------------------
        // 2. MOBILE HAMBURGER MENU
        // -----------------------------------------------------------------
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIconOpen = document.getElementById('menu-icon-open');
        const menuIconClose = document.getElementById('menu-icon-close');

        function toggleMobileMenu(forceState) {
            const isHidden = mobileMenu.classList.contains('hidden');
            const shouldOpen = typeof forceState === 'boolean' ? forceState : isHidden;

            if (shouldOpen) {
                mobileMenu.classList.remove('hidden');
                menuIconOpen.classList.add('hidden');
                menuIconClose.classList.remove('hidden');
            } else {
                mobileMenu.classList.add('hidden');
                menuIconOpen.classList.remove('hidden');
                menuIconClose.classList.add('hidden');
            }
        }

        mobileMenuBtn.addEventListener('click', () => toggleMobileMenu());

        // -----------------------------------------------------------------
        // 3. DARK / LIGHT THEME TOGGLE
        // -----------------------------------------------------------------
        const themeToggleBtn = document.getElementById('theme-toggle');
        const htmlElement = document.documentElement;

        // Check saved preference or system preference
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            htmlElement.classList.add('dark');
        }

        themeToggleBtn.addEventListener('click', () => {
            htmlElement.classList.toggle('dark');
            localStorage.setItem('theme', htmlElement.classList.contains('dark') ? 'dark' : 'light');
        });

        // -----------------------------------------------------------------
        // 4. DYNAMIC AGE & BIRTHDAY CALCULATOR
        // -----------------------------------------------------------------
        function updateAgeStats(birthDateString) {
            if (!birthDateString) return;
            const birthDate = new Date(birthDateString + 'T00:00:00');
            const today = new Date();

            let years = today.getFullYear() - birthDate.getFullYear();
            const monthDiff = today.getMonth() - birthDate.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                years--;
            }

            const totalMonths = (today.getFullYear() - birthDate.getFullYear()) * 12 + (today.getMonth() - birthDate.getMonth());

            // Calculate days until next birthday
            let nextBirthday = new Date(today.getFullYear(), birthDate.getMonth(), birthDate.getDate());
            if (nextBirthday < today) {
                nextBirthday.setFullYear(today.getFullYear() + 1);
            }
            const diffTime = Math.abs(nextBirthday - today);
            const daysToBirthday = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            // Format readable date
            const options = { year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('display-birthdate').textContent = birthDate.toLocaleDateString('en-US', options);

            // Update DOM elements
            document.getElementById('live-age-heading').textContent = `${years} Years Old`;
            document.getElementById('about-quick-age').textContent = `${years} Years Old`;
            document.getElementById('stat-years').textContent = years;
            document.getElementById('stat-months').textContent = Math.max(0, totalMonths);
            document.getElementById('stat-days-next').textContent = daysToBirthday === 365 || daysToBirthday === 366 ? 'Today!' : daysToBirthday;
        }

        // -----------------------------------------------------------------
        // 5. GITHUB GUIDE MODAL & CONTACT FEEDBACK
        // -----------------------------------------------------------------
        const githubModal = document.getElementById('github-modal');

        function openGithubModal() {
            githubModal.classList.remove('hidden');
            githubModal.classList.add('flex');
        }

        function closeGithubModal() {
            githubModal.classList.add('hidden');
            githubModal.classList.remove('flex');
        }

        // Close modal when clicking outside dialog box
        githubModal.addEventListener('click', (e) => {
            if (e.target === githubModal) closeGithubModal();
        });

        function handleContactSubmit(event) {
            event.preventDefault();
            const feedback = document.getElementById('contact-feedback');
            feedback.classList.remove('hidden');
            event.target.reset();
        }
    </script>
</body>
</html>
