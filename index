                            <!-- Replace src with your own photo URL or local image like "profile.jpg" -->
                            <img src="https://placehold.co/400x400/4f46e5/ffffff?text=Your+Photo" 
                                 onerror="this.src='https://placehold.co/400x400/334155/ffffff?text=Avatar'" 
                                 alt="Profile Picture" 
                                 class="w-full h-full object-cover">
                        </div>
                        <span class="absolute -bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap px-3.5 py-1 rounded-full text-xs font-semibold bg-emerald-500 text-white shadow-md flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                            Open to Connect
                        </span>
                    </div>

                    <!-- Bio & Intro Text -->
                    <div class="text-center lg:text-left space-y-4 flex-1">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary-50 text-primary-700 dark:bg-primary-500/10 dark:text-primary-300">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                            <span>Welcome to My Personal Website</span>
                        </div>
                        
                        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                            Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-600 to-violet-500">[Your Full Name]</span>
                        </h1>
                        
                        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
                            [Write a short introduction about yourself here! For example: I am a passionate student, athlete, and aspiring developer based in Your City. Explore the pages above to learn about my school journey, favorite sports, age milestones, and everyday hobbies.]
                        </p>

                        <!-- Quick Action Buttons -->
                        <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-3">
                            <button onclick="navigateTo('school')" class="px-5 py-3 rounded-xl font-semibold text-sm bg-primary-600 hover:bg-primary-700 text-white shadow-md shadow-primary-500/25 transition flex items-center gap-2">
                                <span>Explore My Journey</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </button>
                            <button onclick="navigateTo('contact')" class="px-5 py-3 rounded-xl font-semibold text-sm bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 transition flex items-center gap-2">
                                <i data-lucide="mail" class="w-4 h-4"></i>
                                <span>Say Hello</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Facts Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
                <div onclick="navigateTo('age')" class="cursor-pointer group rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 hover:border-primary-500/50 transition shadow-sm">
                    <div class="w-11 h-11 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="cake" class="w-5 h-5"></i>
