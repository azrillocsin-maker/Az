                        <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
                        <i data-lucide="moon" class="w-4 h-4 block dark:hidden"></i>
                    </button>

                    <!-- Mobile Menu Toggle -->
                    <button id="mobile-menu-btn" aria-label="Open Menu" class="md:hidden p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
                        <i data-lucide="menu" class="w-5 h-5" id="menu-icon-open"></i>
                        <i data-lucide="x" class="w-5 h-5 hidden" id="menu-icon-close"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Dropdown Navigation -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 pt-2 pb-4 space-y-1 shadow-lg">
            <a href="#about" data-page="about" onclick="navigateTo('about')" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium">About Me</a>
            <a href="#school" data-page="school" onclick="navigateTo('school')" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium">School History</a>
            <a href="#sports" data-page="sports" onclick="navigateTo('sports')" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium">Sports</a>
            <a href="#age" data-page="age" onclick="navigateTo('age')" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium">Age & Milestones</a>
            <a href="#hobbies" data-page="hobbies" onclick="navigateTo('hobbies')" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium">Hobbies & Interests</a>
            <a href="#contact" data-page="contact" onclick="navigateTo('contact')" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium">Contact</a>
            <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                <button onclick="openGithubModal(); toggleMobileMenu(false);" class="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-sm font-semibold bg-slate-900 text-white dark:bg-white dark:text-slate-900">
                    <i data-lucide="github" class="w-4 h-4"></i>
                    <span>How to Upload to GitHub</span>
                </button>
            </div>
        </div>
    </header>

    <!-- =====================================================================
         MAIN CONTENT AREA (Multi-Page Views)
         ===================================================================== -->
    <main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

        <!-- =================================================================
             PAGE 1: ABOUT ME (Main Landing Page)
             ================================================================= -->
        <section id="page-about" class="page-section space-y-12">
            <!-- Hero Card -->
            <div class="relative overflow-hidden rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 sm:p-10 lg:p-12 shadow-sm">
                <!-- Decorative Gradient Blobs -->
                <div class="absolute -top-24 -right-24 w-72 h-72 bg-primary-500/10 dark:bg-primary-500/20 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-violet-500/10 dark:bg-violet-500/20 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
