            <div class="relative pl-6 sm:pl-8 border-l-2 border-primary-500/30 space-y-8 my-8">
                
                <!-- Timeline Item 1: College / University -->
                <div class="relative rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
                    <span class="absolute -left-[33px] sm:-left-[41px] top-7 w-4 h-4 rounded-full bg-primary-600 ring-4 ring-white dark:ring-slate-950"></span>
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-primary-50 text-primary-700 dark:bg-primary-500/15 dark:text-primary-300">
                            2024 – Present (Current)
                        </span>
                        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 flex items-center gap-1">
                            <i data-lucide="map-pin" class="w-3.5 h-3.5"></i> [City, Country]
                        </span>
                    </div>
                    <h3 class="font-display text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">[Your University / College Name]</h3>
                    <p class="text-sm font-semibold text-primary-600 dark:text-primary-400 mt-0.5">[Degree / Course, e.g., B.S. in Computer Science]</p>
                    <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base mt-3 leading-relaxed">
                        [Describe your current college experience, student clubs, favorite professors, or major projects you are working on.]
                    </p>
                    <div class="mt-4 flex flex-wrap gap-2">
                        <span class="px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">Dean's List</span>
                        <span class="px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">Tech Club Member</span>
                    </div>
                </div>

                <!-- Timeline Item 2: High School -->
                <div class="relative rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8 shadow-sm">
                    <span class="absolute -left-[33px] sm:-left-[41px] top-7 w-4 h-4 rounded-full bg-violet-500 ring-4 ring-white dark:ring-slate-950"></span>
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-violet-50 text-violet-700 dark:bg-violet-500/15 dark:text-violet-300">
