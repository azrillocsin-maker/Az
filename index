                    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300">
