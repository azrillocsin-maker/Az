                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-primary-600 to-violet-500 flex items-center justify-center text-white font-display font-bold text-lg shadow-md shadow-primary-500/20 group-hover:scale-105 transition-transform">
                        YN
                    </div>
                    <span class="font-display font-bold text-lg tracking-tight text-slate-900 dark:text-white">
                        Your<span class="text-primary-600 dark:text-primary-400">Name</span>
                    </span>
                </a>

                <!-- Desktop Navigation Links -->
                <nav class="hidden md:flex items-center gap-1" id="desktop-nav">
                    <a href="#about" data-page="about" onclick="navigateTo('about')" class="nav-link px-3.5 py-2 rounded-xl text-sm font-medium transition-all">About Me</a>
                    <a href="#school" data-page="school" onclick="navigateTo('school')" class="nav-link px-3.5 py-2 rounded-xl text-sm font-medium transition-all">School History</a>
                    <a href="#sports" data-page="sports" onclick="navigateTo('sports')" class="nav-link px-3.5 py-2 rounded-xl text-sm font-medium transition-all">Sports</a>
                    <a href="#age" data-page="age" onclick="navigateTo('age')" class="nav-link px-3.5 py-2 rounded-xl text-sm font-medium transition-all">Age & Milestones</a>
