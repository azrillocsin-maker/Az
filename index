                    <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Education</p>
                    <h3 class="font-display text-2xl font-bold mt-1 text-slate-900 dark:text-white">[Your School]</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">View full school history &rarr;</p>
                </div>

                <div onclick="navigateTo('sports')" class="cursor-pointer group rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 hover:border-primary-500/50 transition shadow-sm">
                    <div class="w-11 h-11 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="trophy" class="w-5 h-5"></i>
                    </div>
                    <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Main Sport</p>
                    <h3 class="font-display text-2xl font-bold mt-1 text-slate-900 dark:text-white">[Basketball / Track]</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Check sports & stats &rarr;</p>
                </div>

                <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm">
                    <div class="w-11 h-11 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center mb-4">
                        <i data-lucide="map-pin" class="w-5 h-5"></i>
                    </div>
                    <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Hometown</p>
                    <h3 class="font-display text-2xl font-bold mt-1 text-slate-900 dark:text-white">[Your City, Country]</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Born & Raised</p>
                </div>
            </div>

            <!-- Page Directory Cards (So visitors can easily jump to subpages) -->
            <div class="space-y-4">
                <h2 class="font-display text-2xl font-bold text-slate-900 dark:text-white">Explore My Pages</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div onclick="navigateTo('school')" class="cursor-pointer flex items-start gap-4 p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:shadow-md hover:border-primary-500/40 transition">
                        <div class="p-3 rounded-xl bg-primary-50 dark:bg-primary-500/10 text-primary-600 dark:text-primary-400 shrink-0">
                            <i data-lucide="book-open" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h3 class="font-display font-bold text-lg text-slate-900 dark:text-white">School History &rarr;</h3>
